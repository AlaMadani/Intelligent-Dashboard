# =============================================================================
# api-service — Local development environment
# =============================================================================
# Copy this file to .env and fill in your local values:
#   PowerShell: Copy-Item .env.example .env
#   Linux/macOS: cp .env.example .env
#
# Never commit .env files. They contain real secrets.
# All values here are public-safe placeholders.
# =============================================================================

# Application
SPRING_APPLICATION_NAME=api-service
SERVER_PORT=8081

# SQL Server
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=NoveoCareDB;encrypt=true;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_CONSUMER_GROUP_ID=api-service-anomaly-stream
APP_KAFKA_TOPIC_ANOMALY_ALERTS=topic-anomaly-alerts

# NVIDIA NIM & Riva ASR — both use the same API key.
# Required for LLM explanations, Dashboard Assistant, and ASR transcription.
NVIDIA_API_KEY=

# Gemini (optional fallback for LLM explanations)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash

# JWT — generate a strong secret (64+ random characters)
JWT_SECRET=<generate-a-long-random-secret-at-least-64-chars>
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Auth
APP_AUTH_ALLOWED_DOMAIN=@example.com
APP_AUTH_VERIFICATION_MAIL_ENABLED=false
APP_AUTH_VERIFICATION_FROM=<smtp-from-address>
APP_AUTH_VERIFICATION_LOGO_URL=

# SMTP — set APP_AUTH_VERIFICATION_MAIL_ENABLED=true when configured
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<smtp-username>
SPRING_MAIL_PASSWORD=<smtp-password>

# CORS — frontend origin
APP_CORS_ALLOWED_ORIGINS=http://localhost:9008

# ASR
ASR_SERVER=grpc.nvcf.nvidia.com:443
ASR_FUNCTION_ID=<nvidia-riva-function-id>
ASR_FFMPEG_PATH=ffmpeg

# Observability
LOGSTASH_DESTINATION=localhost:5000
