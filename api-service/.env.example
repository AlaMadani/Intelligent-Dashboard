# Spring Boot
SPRING_APPLICATION_NAME=api-service
SERVER_PORT=8081

# SQL Server
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=NoveoCareDB;encrypt=true;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=app_user
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.microsoft.sqlserver.jdbc.SQLServerDriver

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_CONSUMER_GROUP_ID=api-service-anomaly-stream
SPRING_KAFKA_CONSUMER_AUTO_OFFSET_RESET=latest
APP_KAFKA_TOPIC_ANOMALY_ALERTS=topic-anomaly-alerts

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash

# Liquibase
SPRING_LIQUIBASE_ENABLED=false
SPRING_LIQUIBASE_CHANGE_LOG=classpath:db/changelog/db.changelog-master.yaml

# Logging
LOGSTASH_DESTINATION=localhost:5000
