<configuration>
    <!-- Human-readable console logs for local development and debugging. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - [%5p] - %m%n</pattern>
        </encoder>
    </appender>

    <!-- Structured log forwarding for centralized ingestion pipelines. -->
    <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>${LOGSTASH_DESTINATION:-localhost:5000}</destination>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app_name":"data-processor"}</customFields>
        </encoder>
    </appender>

    <!-- Send all logs to both local console output and Logstash. -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="LOGSTASH" />
    </root>
</configuration>
