# =============================================================================
# DataProcessor — Local development environment
# =============================================================================
# Copy this file to .env and fill in your local values:
#   PowerShell: Copy-Item .env.example .env
#   Linux/macOS: cp .env.example .env
#
# Never commit .env files. They contain real secrets.
# All values here are public-safe placeholders.
# =============================================================================

# Database
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=NoveoCareDB;encrypt=true;trustServerCertificate=true;
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=data-processor-group
AUDIT_TRAIL_TOPIC=topic-audit-trail
ANOMALY_ALERTS_TOPIC=topic-anomaly-alerts
AUDIT_TRAIL_DLQ_TOPIC=topic-audit-trail-dlq

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CRITICAL_ALERTS_CHANNEL=CRITICAL_ALERT
REDIS_SYSTEM_TRAFFIC_ANOMALY_CHANNEL=SYSTEM_TRAFFIC_ANOMALY

# Observability
LOGSTASH_DESTINATION=localhost:5000
